FROM docker.io/nvidia/cuda:12.6.2-devel-ubuntu24.04

WORKDIR /app

RUN apt-get update && \
  apt-get install -y \
  build-essential \
  cmake \
  pkg-config \
  libssl-dev \
  g++ \
  curl \
  git \
  ca-certificates \
  libclang-dev \
  ninja-build && \
  rm -rf /var/lib/apt/lists/*

# Install Rust as root
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y

ENV PATH="/root/.cargo/bin:${PATH}"

RUN /root/.cargo/bin/cargo install cargo-watch

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV SERVING_PORT=8080

# Expose port given in the .env file
EXPOSE ${SERVING_PORT}

CMD ["/root/.cargo/bin/cargo", "watch", "-x", "run --features cuda"]
