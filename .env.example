MODEL_PATH=/location/of/model.ext # Location where the model file is stored. Formats might be .onnx, .pt, .pth, .bin, .h5, .pb, .tflite, and .sav
ON_ADDRESS=127.0.0.1              # Address to bind the server to
SERVING_PORT=0000                 # Port to bind the server to
ON_CUDA=false                     # Whether to use CUDA for inference (true/false)
MAX_CON_CALLS=1                   # Maximum number of concurrent calls the server can handle
IMAGE_FILE_NAME=file              # Name of the image file to be used for inference (without extension)
